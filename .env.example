# Server
NODE_ENV=development
PORT=4000

# Database (standalone)
MONGODB_URI=mongodb://127.0.0.1:27017/mongo_final_project
# Replica set example:
# MONGODB_URI=mongodb://127.0.0.1:28017,127.0.0.1:28018,127.0.0.1:28019/?replicaSet=rs0

# Test database
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/mongo_final_project_test

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# HTTP
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Backups
BACKUP_DIR=./backups
