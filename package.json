{
  "name": "mongodb-final-project",
  "version": "1.0.0",
  "description": "Final Project: Production-style backend application built on MongoDB with CRUD, advanced query pipelines, indexing strategies, replication, backups, deployment, and automated tests.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "indexes": "node scripts/createIndexes.js",
    "benchmark": "node scripts/benchmark.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "replica:start": "powershell -ExecutionPolicy Bypass -File scripts/replica-set-start.ps1",
    "replica:stop": "powershell -ExecutionPolicy Bypass -File scripts/replica-set-stop.ps1",
    "replica:init": "mongosh --port 28017 scripts/replica-set-init.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src scripts tests"
  },
  "keywords": [
    "mongodb",
    "final-project",
    "express",
    "mongoose",
    "crud",
    "indexing",
    "replication",
    "backup",
    "deployment"
  ],
  "author": "Sunny Kumar Dev",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bson": "^7.3.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
